# Copiá este archivo como .env y completá los valores.
# Los encontrás en Supabase: Project Settings → API.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-clave-de-supabase

# Opcional: clave para entrar al panel /admin. Si no la definís, la primera
# vez que entres a /admin te pide crear una y la guarda cifrada en Supabase.
ADMIN_PASSWORD=tu-clave-de-administracion
